#!/usr/bin/env fish
# Настройка whisper-dictate: графическая обёртка (GTK), TUI (fzf) или CLI.
#
#   whisper-dictate-setup                  в терминале — TUI/CLI, без терминала — GUI
#   whisper-dictate-setup --gui|--tui|--cli [...]   принудительный режим
#   whisper-dictate-setup status | test [--full]    самопроверка
#   whisper-dictate-setup key NAME [--env]          записать ключ (значение со stdin)
#   whisper-dictate-setup keys ...                  список и проверка ключей
#   whisper-dictate-setup conf KEY [VALUE]          прочитать/записать dictate.conf
#   whisper-dictate-setup bind [apply|remove|status] [--key "SUPER + U"] [--file F]
#                                  [--force] [--replace-legacy] [--dry-run]
#   whisper-dictate-setup qs ii|standalone status|install|remove
#   whisper-dictate-setup doctor [--fix] [--yes]    дубли в кейринге
#   whisper-dictate-setup mt status|download zle-en|en-zle|engine
#                                  модели OPUS-MT для локального перевода
#   whisper-dictate-setup whisper-models status|download NAME   модели whisper и VAD
#   whisper-dictate-setup accel status|install vulkan|hip|cuda   ускоритель whisper
#   whisper-dictate-setup ollama status|install VARIANT|pull NAME
#   whisper-dictate-setup gpu | stt-models [--refresh]
#
# Секреты читаются только со stdin / скрытым вводом, в argv не передаются.

set -g WD_LIBDIR ""
for d in "$WHISPER_DICTATE_LIBDIR" (dirname (realpath (status filename)))/../lib /usr/lib/whisper-dictate
    if test -n "$d"; and test -f $d/setup-core.fish
        set -g WD_LIBDIR (realpath $d)
        break
    end
end
if test -z "$WD_LIBDIR"
    echo "whisper-dictate-setup: не найден setup-core.fish (ожидается в /usr/lib/whisper-dictate)" >&2
    exit 1
end
source $WD_LIBDIR/setup-core.fish

set -l mode auto
set -l args $argv
if contains -- $args[1] --gui --tui --cli
    set mode (string sub -s 3 -- $args[1])
    set -e args[1]
end

function usage
    sed -n '2,/^$/p' (status filename) | string replace -r '^# ?' ''
end

function pick_mode
    if test -t 0
        command -q fzf; and echo tui; or echo cli
    else if test -n "$WAYLAND_DISPLAY$DISPLAY"
        echo gui
    else
        echo cli
    end
end

function run_gui
    set -l gui (command -s whisper-dictate-gui; or echo (dirname (realpath (status filename)))/whisper-dictate-gui)
    test -x $gui; or begin; echo "whisper-dictate-gui не найден" >&2; exit 1; end
    exec $gui
end

switch "$args[1]"
    case -h --help help
        usage
    case status test
        wd_selftest $args[2..-1]
        exit $status
    case key
        set -l name $args[2]
        test -n "$name"; or begin; echo "Использование: key NAME [--env] < значение" >&2; exit 1; end
        set -l where ""
        contains -- --env $args; and set where env
        wd_key_store $name $where
        exit $status
    case keys
        wd_keys_cli $args[2..-1]
        exit $status
    case conf
        if test (count $args) -eq 2
            wd_conf $args[2] ""
        else if test (count $args) -ge 3
            wd_conf_set $args[2] $args[3]
            exit $status
        else
            cat $WD_USER_CONF 2>/dev/null
        end
    case bind
        set -l sub apply
        if contains -- $args[2] apply remove status
            set sub $args[2]
            set -e args[2]
        end
        wd_bind $sub $args[2..-1]
        exit $status
    case qs
        python3 $WD_QS_PY $args[2..-1]
        exit $status
    case doctor
        wd_doctor $args[2..-1]
        exit $status
    case mt
        wd_mt $args[2..-1]
        exit $status
    case gpu accel ollama stt-models
        wd_engines $args
        exit $status
    case whisper-models
        wd_engines whisper --dir (string replace -r '^~' $HOME -- (wd_model_dir)) $args[2..-1]
        exit $status
    case ''
        test $mode = auto; and set mode (pick_mode)
        if test $mode = gui
            run_gui
        end
        source $WD_LIBDIR/ui-$mode.fish
        source $WD_LIBDIR/setup-flow.fish
        wd_flow_main
    case '*'
        echo "Неизвестная команда: $args[1]" >&2
        usage >&2
        exit 1
end
