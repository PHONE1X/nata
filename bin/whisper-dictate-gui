#!/usr/bin/env python3
"""Графическая настройка whisper-dictate. Все изменения делает whisper-dictate-setup."""
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk

SETUP = shutil.which("whisper-dictate-setup") or str(Path(__file__).resolve().parent / "whisper-dictate-setup")
CONF = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "whisper-dictate" / "dictate.conf"
STT_CLOUD_DEFAULT = "openai/gpt-4o-transcribe"
# Как STT_DEFAULT в bin/whisper-dictate: без настройки распознавание идёт в облако.
STT_CLOUD_DEFAULT_FULL = f"openrouter:{STT_CLOUD_DEFAULT}"
KEY_SLOTS = [
    ("openrouter", "OpenRouter", "распознавание в облаке и перевод"),
    ("deepl", "DeepL", "перевод"),
    ("gemini", "Google Gemini", "перевод"),
]
TRANSLATE_CHOICES = [("deepl", "DeepL"), ("gemini", "Google Gemini"), ("local", "Локально (OPUS-MT или Ollama)")]
DEFAULT_MODEL_DIR = "~/.local/share/whisper-dictate/models"
DEFAULT_MT_DIR = "~/.local/share/whisper-dictate/mt-models"
# Совпадают с WHISPER_MODELS в lib/engines.py.
WHISPER_CHOICES = [
    ("ggml-large-v3-turbo.bin", "large-v3-turbo — лучший выбор: точно и быстро"),
    ("ggml-large-v3-turbo-q5_0.bin", "large-v3-turbo q5 — почти так же точно, втрое меньше"),
    ("ggml-large-v3.bin", "large-v3 — самая точная, медленнее"),
    ("ggml-medium.bin", "medium"),
    ("ggml-small.bin", "small — для слабых машин"),
    ("ggml-base.bin", "base — быстро, но много ошибок"),
]
VAD_NAME = "ggml-silero-v5.1.2.bin"
ACCEL_TITLES = {"vulkan": "Vulkan", "hip": "ROCm (AMD)", "cuda": "CUDA (NVIDIA)", "cpu": "процессор"}
ACCEL_CHOICES = [("auto", "Авто"), ("vulkan", "Vulkan"), ("hip", "ROCm (AMD)"), ("cuda", "CUDA (NVIDIA)"),
                 ("cpu", "Процессор")]
OLLAMA_CHOICES = [("vulkan", "Vulkan"), ("rocm", "ROCm (AMD)"), ("cuda", "CUDA (NVIDIA)"), ("cpu", "Процессор")]
QS_TARGETS = [
    ("standalone", "Отдельный виджет", "Самостоятельный индикатор. Запуск: qs -c whisper-dictate"),
    ("ii", "Logical Impulse (ii)", "Кнопка в баре и пункт «Диктовка» в настройках. После установки перезапустите Quickshell."),
]


def setup(*args, stdin=None):
    try:
        proc = subprocess.run([SETUP, *args], input=stdin, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as err:
        return 1, str(err)
    return proc.returncode, (proc.stdout + proc.stderr).strip()


def read_conf():
    values = {}
    if CONF.is_file():
        for line in CONF.read_text(encoding="utf-8").splitlines():
            key, sep, value = line.partition("=")
            if sep and key.strip() and not key.lstrip().startswith("#"):
                values[key.strip()] = value.strip().strip("\"'")
    return values


def saved_key_names():
    rc, out = setup("keys", "--list")
    if rc != 0:
        return set()
    return {line.strip() for line in out.splitlines()[1:] if line.strip()}


def stored(name):
    rc, out = setup("keys", "--get", name)
    return out if rc == 0 else ""


# Значение, которое реально использует диктовка: dictate.conf перекрывает связку ключей.
def effective(conf, conf_key, slot):
    return conf.get(conf_key) or stored(slot)


def box(spacing=8):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing,
                   margin_top=16, margin_bottom=16, margin_start=16, margin_end=16)


def heading(text):
    label = Gtk.Label(xalign=0, margin_top=8)
    label.set_markup(f"<b>{GLib.markup_escape_text(text)}</b>")
    return label


def hint(text):
    label = Gtk.Label(label=text, xalign=0, wrap=True)
    label.add_css_class("dim-label")
    return label


def row(*widgets):
    line = Gtk.Box(spacing=8)
    for widget in widgets:
        line.append(widget)
    return line


def scrolled(child):
    scroll = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
    scroll.set_child(child)
    return scroll


class Settings(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Nata", default_width=820, default_height=600)
        self.conf = read_conf()

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True, vexpand=True)
        sidebar = Gtk.StackSidebar(stack=self.stack)
        self.status = Gtk.Label(xalign=0, wrap=True, margin_start=16, margin_end=16, margin_bottom=8)

        self.progress = Gtk.ProgressBar(show_text=True, visible=False, margin_start=16, margin_end=16)
        self.busy = False

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.stack)
        content.append(self.progress)
        content.append(self.status)
        split = Gtk.Box(spacing=0)
        split.append(sidebar)
        split.append(content)
        self.set_child(split)

        # Кнопка в шапке: с неё начинается настройка в одно нажатие.
        header = Gtk.HeaderBar()
        header.set_title_widget(Gtk.Label(label="Nata"))
        self.auto_button = Gtk.Button(label="Автонастройка")
        self.auto_button.set_tooltip_text("Nata сама подберёт ускоритель и модели под ваш компьютер")
        self.auto_button.add_css_class("suggested-action")
        self.auto_button.connect("clicked", self.auto_start)
        header.pack_end(self.auto_button)
        self.set_titlebar(header)

        self.build_pages()

    def build_pages(self):
        self.add_page("auto", "Автонастройка", self.auto_page())
        self.add_page("recognition", "Распознавание", self.recognition_page())
        self.add_page("translation", "Перевод", self.translation_page())
        self.add_page("keys", "API-ключи", self.keys_page())
        self.add_page("hotkey", "Горячая клавиша", self.hotkey_page())
        self.add_page("integrations", "Quickshell", self.integrations_page())
        self.add_page("checks", "Проверка", self.checks_page())

    def reload_pages(self):
        """После автонастройки страницы строятся заново, чтобы показать новые значения."""
        visible = self.stack.get_visible_child_name()
        self.conf = read_conf()
        while (child := self.stack.get_first_child()) is not None:
            self.stack.remove(child)
        self.build_pages()
        if visible:
            self.stack.set_visible_child_name(visible)

    def add_page(self, name, title, child):
        self.stack.add_titled(scrolled(child), name, title)

    def say(self, text):
        self.status.set_text(text)

    def write_conf(self, key, value):
        rc, out = setup("conf", key, value)
        if rc:
            self.say(f"Ошибка записи {key}: {out}")
            return False
        self.conf[key] = value
        self.say(f"Сохранено: {key}")
        return True

    def save_setting(self, conf_key, slot, value):
        rc, out = setup("key", slot, stdin=value)
        if rc:
            self.say(f"Ошибка записи {slot}: {out}")
            return False
        if self.conf.get(conf_key):
            setup("conf", conf_key, "")
            self.conf[conf_key] = ""
        self.say(f"Сохранено: {slot}")
        return True

    def choose_file(self, entry):
        dialog = Gtk.FileDialog(title="Выберите файл")

        def done(dlg, result):
            try:
                entry.set_text(dlg.open_finish(result).get_path())
            except GLib.Error:
                pass

        dialog.open(self, None, done)

    def file_row(self, value, placeholder):
        entry = Gtk.Entry(text=value, placeholder_text=placeholder, hexpand=True)
        browse = Gtk.Button(label="Выбрать…")
        browse.connect("clicked", lambda _b: self.choose_file(entry))
        return entry, row(entry, browse)

    # ─────────────────────────── фоновые задачи ───────────────────────────
    # Загрузки и установка пакетов идут через whisper-dictate-setup в фоне:
    # строки «PROGRESS N» двигают полосу, остальные строки — в строку статуса.
    # Пока задача идёт, страницы недоступны, чтобы не запустить вторую.

    def run_job(self, args, on_done=None):
        if self.busy:
            self.say("Дождитесь окончания текущей задачи.")
            return
        try:
            proc = Gio.Subprocess.new([SETUP, *args],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as err:
            self.say(f"Не удалось запустить: {err.message}")
            return
        self.busy = True
        self.stack.set_sensitive(False)
        self.progress.set_fraction(0)
        self.progress.set_text("")
        self.progress.set_visible(True)
        self.say("Выполняется…")
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        last = []

        def on_line(src, result):
            try:
                line, _len = src.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                proc.wait_async(None, on_exit)
                return
            if line.startswith("PROGRESS "):
                pct = int(line.split()[1])
                self.progress.set_fraction(pct / 100)
                self.progress.set_text(f"{pct} %")
            elif line.strip():
                last.append(line.strip())
                self.say(line.strip())
            src.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        def on_exit(p, result):
            p.wait_finish(result)
            ok = p.get_exit_status() == 0
            self.busy = False
            self.stack.set_sensitive(True)
            self.progress.set_visible(False)
            self.say(("Готово. " if ok else "Ошибка. ") + (last[-1] if last else ""))
            if on_done:
                on_done(ok)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def read_async(self, args, on_done):
        """Короткая команда без блокировки окна (например, список моделей из сети)."""
        proc = Gio.Subprocess.new([SETUP, *args], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)

        def done(p, result):
            try:
                _ok, out, _err = p.communicate_utf8_finish(result)
            except GLib.Error:
                out = ""
            on_done(out or "")

        proc.communicate_utf8_async(None, None, done)

    def choose_folder(self, entry, on_chosen=None):
        dialog = Gtk.FileDialog(title="Выберите папку")

        def done(dlg, result):
            try:
                entry.set_text(dlg.select_folder_finish(result).get_path())
            except GLib.Error:
                return
            if on_chosen:
                on_chosen()

        dialog.select_folder(self, None, done)

    def folder_row(self, value, on_chosen):
        entry = Gtk.Entry(text=value, hexpand=True)
        browse = Gtk.Button(label="Выбрать папку…")
        browse.connect("clicked", lambda _b: self.choose_folder(entry, on_chosen))
        entry.connect("activate", lambda _e: on_chosen())
        return entry, row(entry, browse)

    # ───────────────────────── быстрая настройка ──────────────────────────

    def auto_page(self):
        page = box(10)
        page.append(heading("Автонастройка"))
        page.append(hint("Одно нажатие — и Nata сама выбирает самый быстрый вариант под ваше железо: "
                         "ускоритель, модель распознавания, перевод. Нужные пакеты ставятся, модели "
                         "скачиваются. Дальше всё можно поменять вручную на остальных страницах."))
        rc, out = setup("plan")
        plan = dict(line.split(" ", 1) for line in out.splitlines() if " " in line) if rc == 0 else {}
        if plan:
            gpu = plan.get("gpu_name", "-")
            gpu = "не найдена" if gpu == "-" else f"{gpu}, {plan.get('vram')} ГБ"
            accel = ACCEL_TITLES.get(plan.get("accel"), plan.get("accel"))
            model = dict(WHISPER_CHOICES).get(plan.get("model"), plan.get("model", "")).split(" — ")[0]
            page.append(hint(f"Видеокарта: {gpu}\nПроцессор: {plan.get('cpu')}, потоков {plan.get('threads')}, "
                             f"ОЗУ {plan.get('ram')} ГБ\n\nДля этого компьютера: распознавание на «{accel}», "
                             f"модель whisper {model}."))
        page.append(self.last_run_box())
        button = Gtk.Button(label="Настроить автоматически", halign=Gtk.Align.START, margin_top=8)
        button.add_css_class("suggested-action")
        button.connect("clicked", self.auto_start)
        page.append(button)
        return page

    # ─────────────────── что было в последнем запуске ─────────────────────

    def last_run_box(self):
        title = Gtk.Label(xalign=0)
        title.set_markup("<b>Последний запуск</b>")
        label = Gtk.Label(xalign=0, wrap=True, hexpand=True)
        refresh = Gtk.Button(label="Обновить", valign=Gtk.Align.START)
        refresh.connect("clicked", lambda _b: self.refresh_last(label))
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        frame.append(title)
        frame.append(row(label, refresh))
        self.refresh_last(label)
        return frame

    def refresh_last(self, label):
        rc, out = setup("last")
        fields = dict(line.split("\t", 1) for line in out.splitlines() if "\t" in line)
        if rc != 0 or fields.get("empty") == "1" or not fields.get("text"):
            label.set_text("Диктовка ещё не запускалась.")
            return
        label.set_text(fields["text"])
        details = [f"{fields.get('when', '')}"]
        if fields.get("lang"):
            details.append(f"язык {fields['lang']}")
        if fields.get("stt"):
            details.append(fields["stt"])
        label.set_tooltip_text(" · ".join(details))
        if fields.get("reason"):
            label.add_css_class("warning")

    def auto_start(self, _button):
        dialog = Gtk.AlertDialog(message="Где распознавать и переводить?",
                                 detail="На этом компьютере — бесплатно и без интернета, всё скачается само.\n"
                                        "В облаке — нужны ключи (OpenRouter с балансом от $0.50, DeepL или Gemini); "
                                        "локальная модель всё равно скачается про запас.",
                                 buttons=["Отмена", "В облаке", "На этом компьютере"],
                                 cancel_button=0, default_button=2)

        def done(dlg, result):
            try:
                choice = dlg.choose_finish(result)
            except GLib.Error:
                return
            if choice == 2:
                self.run_job(["auto", "local"], self.auto_done)
            elif choice == 1:
                self.auto_cloud_form()

        dialog.choose(self, None, done)

    def auto_cloud_form(self):
        saved = saved_key_names()
        win = Gtk.Window(title="Облачная настройка", transient_for=self, modal=True, default_width=520)
        page = box(10)
        page.append(heading("Распознавание: OpenRouter"))
        rc, out = setup("stt-models", "--best")
        best = out.strip().splitlines()[0] if rc == 0 and out.strip() else STT_CLOUD_DEFAULT
        page.append(hint(f"Модель выбирается сама: {best}. На балансе OpenRouter нужно от $0.50."))
        balance = Gtk.Label(xalign=0, wrap=True)
        rc, out = setup("keys", "--credits")
        if rc == 0:
            credits = dict(line.split("\t", 1) for line in out.splitlines() if "\t" in line)
            left = (credits.get("remaining") or "0").replace(",", ".")
            try:
                low = float(left) < 0.5
            except ValueError:
                low = False
            balance.set_text(f"Баланс OpenRouter: ${left}." + (" Мало: облако не ответит, пока не будет $0.50."
                                                             if low else ""))
            if low:
                balance.add_css_class("warning")
        else:
            balance.set_text("Баланс OpenRouter проверить не удалось.")
            balance.add_css_class("dim-label")
        page.append(balance)
        openrouter = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        openrouter.set_property("placeholder-text", "сохранён — можно не вводить" if "openrouter" in saved
                                else "ключ OpenRouter")
        page.append(row(Gtk.Label(label="Ключ OpenRouter", xalign=0, width_chars=16), openrouter))
        page.append(heading("Перевод"))
        choices = [("deepl", "DeepL"), ("gemini", "Google Gemini"), ("local", "Локально (OPUS-MT, без ключа)")]
        buttons, group = [], None
        for value, label in choices:
            radio = Gtk.CheckButton(label=label, group=group, active=value == "deepl")
            group = group or radio
            buttons.append((value, radio))
            page.append(radio)
        key_label = Gtk.Label(xalign=0, width_chars=16)
        key = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        key_row = row(key_label, key)
        page.append(key_row)
        error = Gtk.Label(xalign=0, wrap=True)
        error.add_css_class("error")

        def provider():
            return next(value for value, radio in buttons if radio.get_active())

        def update(*_args):
            prov = provider()
            key_row.set_visible(prov != "local")
            key_label.set_text(f"Ключ {dict(choices)[prov]}" if prov != "local" else "")
            key.set_text("")
            error.set_text("")
            key.set_property("placeholder-text", "сохранён — можно не вводить" if prov in saved
                             else f"ключ {dict(choices)[prov]}")

        for _value, radio in buttons:
            radio.connect("toggled", update)
        update()
        page.append(error)

        def confirm(_b):
            prov = provider()
            entered = {"openrouter": openrouter.get_text().strip()}
            if prov != "local":
                entered[prov] = key.get_text().strip()
            missing = [slot for slot, value in entered.items() if not value and slot not in saved]
            if missing:
                error.set_text("Нужен ключ: " + ", ".join(missing))
                return
            for slot, value in entered.items():
                if value:
                    rc, out = setup("key", slot, stdin=value)
                    if rc:
                        error.set_text(f"Не удалось сохранить ключ {slot}: {out}")
                        return
            win.close()
            self.run_job(["auto", "cloud", prov], self.auto_done)

        cancel = Gtk.Button(label="Отмена")
        cancel.connect("clicked", lambda _b: win.close())
        go = Gtk.Button(label="Настроить")
        go.add_css_class("suggested-action")
        go.connect("clicked", confirm)
        page.append(row(Gtk.Box(hexpand=True), cancel, go))
        win.set_child(page)
        win.present()

    def auto_done(self, ok):
        message = self.status.get_text()
        self.reload_pages()
        self.say(message if ok else message + " Подробности — на странице «Проверка».")

    # ─────────────────────────── распознавание ────────────────────────────

    def recognition_page(self):
        page = box(10)
        stt = effective(self.conf, "STT", "dictationStt") or STT_CLOUD_DEFAULT_FULL
        cloud = stt.startswith("openrouter:")

        page.append(self.last_run_box())

        page.append(heading("Где распознавать речь"))
        self.stt_cloud = Gtk.CheckButton(label="В облаке (OpenRouter) — нужен ключ и баланс от $0.50", active=cloud)
        self.stt_local = Gtk.CheckButton(label="На этом компьютере (whisper.cpp)", group=self.stt_cloud,
                                         active=not cloud)
        page.append(self.stt_cloud)
        page.append(self.stt_local)
        page.append(hint("В облачном режиме кусок, на который облако не ответило, распознаётся локально — "
                         "поэтому локальную модель стоит скачать в любом случае."))

        page.append(heading("Облачная модель"))
        self.cloud_ids = []
        self.cloud_list = Gtk.DropDown.new_from_strings(["Загружаю список…"])
        self.cloud_list.set_hexpand(True)
        self.cloud_list.connect("notify::selected", self.cloud_selected)
        refresh = Gtk.Button(label="Обновить список")
        refresh.connect("clicked", lambda _b: self.load_cloud_models(True))
        page.append(row(self.cloud_list, refresh))
        self.stt_model = Gtk.Entry(text=stt.split(":", 1)[1] if cloud else STT_CLOUD_DEFAULT, hexpand=True,
                                   placeholder_text=STT_CLOUD_DEFAULT)
        page.append(row(Gtk.Label(label="Идентификатор", xalign=0, width_chars=16), self.stt_model))
        page.append(hint("Список — все модели распознавания OpenRouter с ценой за минуту. "
                         "Можно вписать любую другую модель вручную."))

        page.append(heading("Ускоритель для локального распознавания"))
        rc, out = setup("gpu")
        info = dict(line.split(" ", 1) for line in out.splitlines() if " " in line) if rc == 0 else {}
        vendor = {"amd": "AMD", "nvidia": "NVIDIA", "intel": "Intel"}.get(info.get("gpu"), "не найдена")
        recommended = info.get("recommended", "cpu")
        page.append(hint(f"Видеокарта: {vendor}. Рекомендуется: {ACCEL_TITLES.get(recommended, recommended)}."))
        current = self.conf.get("WHISPER_BACKEND") or "auto"
        self.accel_values = [value for value, _title in ACCEL_CHOICES]
        self.accel_list = Gtk.DropDown.new_from_strings(
            [f"{title} ({ACCEL_TITLES.get(recommended, recommended)})" if value == "auto" else title
             for value, title in ACCEL_CHOICES])
        self.accel_list.set_selected(self.accel_values.index(current) if current in self.accel_values else 0)
        page.append(row(Gtk.Label(label="Считать на", xalign=0, width_chars=16), self.accel_list))
        self.accel_rows = {}
        for name in ("vulkan", "hip", "cuda"):
            state = Gtk.Label(xalign=0, hexpand=True, wrap=True)
            button = Gtk.Button(label="Установить")
            button.connect("clicked", lambda _b, n=name: self.run_job(["accel", "install", n],
                                                                       lambda _ok: self.refresh_accel()))
            self.accel_rows[name] = (state, button)
            page.append(row(Gtk.Label(label=ACCEL_TITLES[name], xalign=0, width_chars=16), state, button))
        page.append(hint("Установка пакета спросит пароль системы. Если выбранный ускоритель не установлен, "
                         "whisper считает на процессоре."))

        page.append(heading("Локальные модели whisper"))
        self.model_dir, dir_row = self.folder_row(os.path.expanduser(self.conf.get("MODEL_DIR") or DEFAULT_MODEL_DIR),
                                                  self.save_model_dir)
        page.append(row(Gtk.Label(label="Папка моделей", xalign=0, width_chars=16), dir_row))
        self.whisper_rows = {}
        group = None
        chosen = os.path.basename(self.conf.get("MODEL") or "ggml-large-v3-turbo.bin")
        for name, title in WHISPER_CHOICES:
            pick = Gtk.CheckButton(label=title, group=group, active=name == chosen, hexpand=True)
            group = group or pick
            state = Gtk.Label(xalign=0, width_chars=14)
            button = Gtk.Button(label="Скачать")
            button.connect("clicked", self.download_whisper, name)
            self.whisper_rows[name] = (pick, state, button)
            page.append(row(pick, state, button))
        vad_state = Gtk.Label(xalign=0, width_chars=14)
        vad_button = Gtk.Button(label="Скачать")
        vad_button.connect("clicked", self.download_whisper, VAD_NAME)
        self.whisper_rows[VAD_NAME] = (None, vad_state, vad_button)
        page.append(row(Gtk.Label(label="VAD — обрезка тишины (нужна всегда)", xalign=0, hexpand=True),
                        vad_state, vad_button))
        custom = self.conf.get("MODEL", "") if "/" in self.conf.get("MODEL", "") else ""
        self.model_entry, model_row = self.file_row(custom, "или свой файл ggml-*.bin (необязательно)")
        page.append(row(Gtk.Label(label="Свой файл", xalign=0, width_chars=16), model_row))

        save = Gtk.Button(label="Сохранить распознавание", halign=Gtk.Align.START, margin_top=8)
        save.add_css_class("suggested-action")
        save.connect("clicked", self.save_stt)
        page.append(save)

        self.refresh_accel()
        self.refresh_whisper()
        self.load_cloud_models(False)
        return page

    def load_cloud_models(self, refresh):
        def done(out):
            items = [line.split("\t") for line in out.splitlines() if "\t" in line]
            if not items:
                self.say("Не удалось получить список моделей OpenRouter.")
                return
            current = self.stt_model.get_text().strip() or STT_CLOUD_DEFAULT
            # Замена списка сама выбирает первый пункт — не даём ей затереть сохранённую модель.
            self.cloud_ids = []
            labels = [f"{item[1]}  {item[2]}".strip() for item in items]
            self.cloud_list.set_model(Gtk.StringList.new(labels))
            self.cloud_ids = [item[0] for item in items]
            if current in self.cloud_ids:
                self.cloud_list.set_selected(self.cloud_ids.index(current))
            else:
                self.stt_model.set_text(current)

        self.read_async(["stt-models", *(["--refresh"] if refresh else [])], done)

    def cloud_selected(self, dropdown, _param):
        index = dropdown.get_selected()
        if 0 <= index < len(self.cloud_ids):
            self.stt_model.set_text(self.cloud_ids[index])

    def refresh_accel(self):
        rc, out = setup("accel", "status")
        states = {line.split(" ")[0]: line.split(" ")[1] for line in out.splitlines() if " " in line}
        for name, (state, button) in self.accel_rows.items():
            ok = states.get(name) == "ok"
            state.set_text("установлен" if ok else ("не установлен" if rc == 0 else "не удалось проверить"))
            button.set_visible(not ok)

    def save_model_dir(self):
        if self.write_conf("MODEL_DIR", self.model_dir.get_text().strip()):
            self.refresh_whisper()

    def refresh_whisper(self):
        rc, out = setup("whisper-models", "status")
        states = {}
        for line in out.splitlines():
            parts = line.split(" ", 3)
            if len(parts) >= 3 and parts[0] != "dir":
                states[parts[0]] = (parts[1] == "ok", int(parts[2]))
        for name, (pick, state, button) in self.whisper_rows.items():
            ok, size = states.get(name, (False, 0))
            state.set_text("скачана" if ok else f"{size / 1e9:.1f} ГБ" if size >= 1e9 else f"{size / 1e6:.0f} МБ" if size >= 1e7 else f"{size / 1e6:.1f} МБ")
            button.set_visible(not ok)
            if pick is not None:
                pick.set_sensitive(ok)

    def download_whisper(self, _button, name):
        if self.model_dir.get_text().strip() != os.path.expanduser(self.conf.get("MODEL_DIR") or DEFAULT_MODEL_DIR):
            if not self.write_conf("MODEL_DIR", self.model_dir.get_text().strip()):
                return
        self.run_job(["whisper-models", "download", name], lambda _ok: self.refresh_whisper())

    def save_stt(self, _button):
        if self.stt_cloud.get_active():
            model = self.stt_model.get_text().strip() or STT_CLOUD_DEFAULT
            self.save_setting("STT", "dictationStt", f"openrouter:{model}")
        else:
            self.save_setting("STT", "dictationStt", "local")
        self.write_conf("WHISPER_BACKEND", self.accel_values[self.accel_list.get_selected()])
        custom = self.model_entry.get_text().strip()
        picked = next((name for name, (pick, _s, _b) in self.whisper_rows.items()
                       if pick is not None and pick.get_active()), None)
        if custom:
            self.write_conf("MODEL", custom)
        elif picked:
            self.write_conf("MODEL", picked)
        self.say("Распознавание сохранено.")

    # ───────────────────────────── перевод ────────────────────────────────

    def translation_page(self):
        page = box(10)
        current = effective(self.conf, "TRANSLATE_PROVIDER", "dictationProvider") or "gemini"
        self.translate_buttons = []
        group = None
        page.append(heading("Провайдер перевода"))
        page.append(hint("Перевод нужен, когда раскладка не русская."))
        for value, label in TRANSLATE_CHOICES:
            button = Gtk.CheckButton(label=label, group=group, active=value == current)
            group = group or button
            self.translate_buttons.append((value, button))
            page.append(button)
        self.gemini_model = Gtk.Entry(text=effective(self.conf, "GEMINI_MODEL", "geminiDictationModel"),
                                      hexpand=True, placeholder_text="__auto__ — выбрать модель автоматически")
        page.append(row(Gtk.Label(label="Модель Gemini", xalign=0, width_chars=16), self.gemini_model))
        page.append(hint("Ключи DeepL и Gemini — на странице «API-ключи»."))

        local = stored("dictationLocalModel")
        page.append(heading("Локальный перевод: чем переводить"))
        self.local_opus = Gtk.CheckButton(label="OPUS-MT — на процессоре, быстро, только русский ↔ английский",
                                          active=not local.startswith("ollama:"))
        self.local_ollama = Gtk.CheckButton(label="Ollama — языковая модель на видеокарте, любые языки",
                                            group=self.local_opus, active=local.startswith("ollama:"))
        page.append(self.local_opus)
        page.append(self.local_ollama)

        page.append(heading("OPUS-MT"))
        self.mt_dir, dir_row = self.folder_row(
            os.path.expanduser(self.conf.get("MT_MODEL_DIR") or DEFAULT_MT_DIR), self.save_mt_dir)
        page.append(row(Gtk.Label(label="Папка моделей", xalign=0, width_chars=16), dir_row))
        self.mt_rows = {}
        for key, title, action in (("zle-en", "Русский → английский (240 МБ)", "Скачать"),
                                   ("en-zle", "Английский → русский (240 МБ)", "Скачать"),
                                   ("engine", "Движок ctranslate2", "Установить")):
            state = Gtk.Label(xalign=0, hexpand=True)
            button = Gtk.Button(label=action)
            button.connect("clicked", self.run_mt, key)
            self.mt_rows[key] = (state, button)
            page.append(row(Gtk.Label(label=title, xalign=0, width_chars=30), state, button))

        page.append(heading("Ollama"))
        self.ollama_state = Gtk.Label(xalign=0, wrap=True)
        page.append(self.ollama_state)
        rc, out = setup("gpu")
        recommended = {"vulkan": "vulkan", "cuda": "cuda"}.get(
            dict(line.split(" ", 1) for line in out.splitlines() if " " in line).get("recommended"), "cpu")
        self.ollama_variants = [value for value, _title in OLLAMA_CHOICES]
        self.ollama_variant = Gtk.DropDown.new_from_strings([title for _value, title in OLLAMA_CHOICES])
        self.ollama_variant.set_selected(self.ollama_variants.index(recommended))
        self.ollama_install = Gtk.Button(label="Установить Ollama")
        self.ollama_install.connect("clicked", lambda _b: self.run_job(
            ["ollama", "install", self.ollama_variants[self.ollama_variant.get_selected()]],
            lambda _ok: self.refresh_ollama()))
        page.append(row(Gtk.Label(label="Ускоритель", xalign=0, width_chars=16), self.ollama_variant,
                        self.ollama_install))
        self.ollama_names = []
        self.ollama_models = Gtk.DropDown.new_from_strings(["—"])
        self.ollama_models.set_hexpand(True)
        page.append(row(Gtk.Label(label="Модель", xalign=0, width_chars=16), self.ollama_models))
        self.ollama_pull_name = Gtk.Entry(hexpand=True, placeholder_text="например hunyuan-mt:7b или qwen2.5:7b")
        pull = Gtk.Button(label="Скачать модель")
        pull.connect("clicked", self.pull_ollama)
        page.append(row(Gtk.Label(label="Скачать", xalign=0, width_chars=16), self.ollama_pull_name, pull))
        self.ollama_current = local.split(":", 1)[1] if local.startswith("ollama:") else ""

        page.append(heading("Дополнительно"))
        self.translate_script, script_row = self.file_row(
            self.conf.get("TRANSLATE_SCRIPT") or os.path.expanduser("~/.config/quickshell/ii/scripts/ai/local-translate.sh"),
            "/путь/к/local-translate.sh")
        page.append(row(Gtk.Label(label="Скрипт перевода", xalign=0, width_chars=16), script_row))

        save = Gtk.Button(label="Сохранить перевод", halign=Gtk.Align.START, margin_top=8)
        save.add_css_class("suggested-action")
        save.connect("clicked", self.save_translate)
        page.append(save)
        self.refresh_mt()
        self.refresh_ollama()
        return page

    def save_mt_dir(self):
        if self.write_conf("MT_MODEL_DIR", self.mt_dir.get_text().strip()):
            self.refresh_mt()

    def refresh_mt(self):
        rc, out = setup("mt", "status")
        states = {line.split(" ")[0]: line.split(" ")[1] for line in out.splitlines() if " " in line}
        for key, (state, button) in self.mt_rows.items():
            ok = states.get(key) == "ok"
            state.set_text("установлено" if ok else ("нет" if rc == 0 else "не удалось проверить"))
            button.set_visible(not ok)

    def run_mt(self, _button, key):
        if self.mt_dir.get_text().strip() != os.path.expanduser(self.conf.get("MT_MODEL_DIR") or DEFAULT_MT_DIR):
            if not self.write_conf("MT_MODEL_DIR", self.mt_dir.get_text().strip()):
                return
        self.run_job(["mt", "engine"] if key == "engine" else ["mt", "download", key], lambda _ok: self.refresh_mt())

    def refresh_ollama(self):
        rc, out = setup("ollama", "status")
        info, models = {}, []
        for line in out.splitlines():
            parts = line.split(" ")
            if parts[0] == "model" and len(parts) >= 3:
                models.append((parts[1], int(parts[2])))
            elif parts[0] == "variant" and len(parts) >= 3:
                info[f"variant-{parts[1]}"] = parts[2]
            elif len(parts) >= 2:
                info[parts[0]] = parts[1]
        variants = [v for v in ("vulkan", "rocm", "cuda") if info.get(f"variant-{v}") == "ok"]
        if info.get("installed") != "yes":
            text = "Ollama не установлена. Выберите ускоритель и нажмите «Установить Ollama»."
        elif info.get("service") != "up":
            text = "Ollama установлена, но служба не запущена. «Установить Ollama» включит её."
        else:
            text = f"Ollama работает, ускоритель: {', '.join(variants) or 'процессор'}, моделей: {len(models)}."
        self.ollama_state.set_text(text)
        self.ollama_install.set_label("Добавить ускоритель" if info.get("service") == "up" else "Установить Ollama")
        self.ollama_names = [name for name, _size in models]
        labels = [f"{name}  ({size / 1e9:.1f} ГБ)" for name, size in models] or ["нет моделей"]
        self.ollama_models.set_model(Gtk.StringList.new(labels))
        if self.ollama_current in self.ollama_names:
            self.ollama_models.set_selected(self.ollama_names.index(self.ollama_current))

    def pull_ollama(self, _button):
        name = self.ollama_pull_name.get_text().strip()
        if not name:
            self.say("Впишите имя модели Ollama.")
            return
        self.ollama_current = name if ":" in name else f"{name}:latest"
        self.run_job(["ollama", "pull", name], lambda _ok: self.refresh_ollama())

    def save_translate(self, _button):
        chosen = next(value for value, button in self.translate_buttons if button.get_active())
        self.save_setting("TRANSLATE_PROVIDER", "dictationProvider", chosen)
        gemini = self.gemini_model.get_text().strip()
        if gemini:
            self.save_setting("GEMINI_MODEL", "geminiDictationModel", gemini)
        if self.local_ollama.get_active():
            index = self.ollama_models.get_selected()
            if 0 <= index < len(self.ollama_names):
                self.save_setting("", "dictationLocalModel", f"ollama:{self.ollama_names[index]}")
            elif chosen == "local":
                self.say("Для Ollama выберите или скачайте модель.")
                return
        else:
            self.save_setting("", "dictationLocalModel", "marian:opus-tc-big")
        script = self.translate_script.get_text().strip()
        if script:
            self.write_conf("TRANSLATE_SCRIPT", script)
        self.say("Перевод сохранён.")

    def keys_page(self):
        page = box(12)
        page.append(heading("API-ключи"))
        page.append(hint("Ключи сохраняются в libsecret (связка ключей) или в ~/.config/whisper-dictate/secrets.env с правами 0600. В файлы настроек не попадают."))
        self.key_entries = {}
        self.key_states = {}
        for slot, title, purpose in KEY_SLOTS:
            entry = Gtk.PasswordEntry(hexpand=True, show_peek_icon=True)
            state = Gtk.Label(xalign=0)
            save = Gtk.Button(label="Сохранить")
            save.connect("clicked", self.save_key, slot)
            self.key_entries[slot] = entry
            self.key_states[slot] = state
            page.append(heading(f"{title} — {purpose}"))
            page.append(row(entry, save))
            page.append(state)
        self.refresh_keys()
        return page

    def refresh_keys(self):
        saved = saved_key_names()
        for slot, _title, _purpose in KEY_SLOTS:
            self.key_states[slot].set_text("сохранён" if slot in saved else "не задан")

    def save_key(self, _button, slot):
        value = self.key_entries[slot].get_text().strip()
        if not value:
            self.say("Поле ключа пустое.")
            return
        rc, out = setup("key", slot, stdin=value)
        self.key_entries[slot].set_text("")
        self.say(f"Ключ {slot} сохранён." if rc == 0 else f"Ошибка: {out}")
        self.refresh_keys()

    def hotkey_page(self):
        page = box(10)
        page.append(heading("Горячая клавиша"))
        if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            page.append(hint("Автоматическая привязка есть только для Hyprland. В другом окружении назначьте сочетание для команды whisper-dictate в настройках клавиатуры."))
            return page
        self.hotkey = Gtk.Entry(text="SUPER + U", hexpand=True)
        apply = Gtk.Button(label="Привязать")
        apply.connect("clicked", self.apply_hotkey)
        page.append(hint("Команда: whisper-dictate. Если сочетание уже занято, появится сообщение о конфликте."))
        page.append(row(Gtk.Label(label="Сочетание", xalign=0, width_chars=10), self.hotkey, apply))
        return page

    def apply_hotkey(self, _button):
        key = self.hotkey.get_text().strip()
        if not key:
            return
        rc, out = setup("bind", "apply", "--key", key)
        self.say(out or "Привязка записана." if rc == 0 else out)

    def integrations_page(self):
        page = box(14)
        page.append(heading("Интеграция с Quickshell"))
        page.append(hint("Модуль копируется в конфиги Quickshell. Удаление убирает только то, что добавил модуль."))
        self.qs_states = {}
        self.qs_buttons = {}
        for target, title, note in QS_TARGETS:
            state = Gtk.Label(xalign=0)
            button = Gtk.Button(label="Подключить")
            button.connect("clicked", self.toggle_qs, target)
            self.qs_states[target] = state
            self.qs_buttons[target] = button
            page.append(heading(title))
            page.append(hint(note))
            page.append(row(state, button))
        self.refresh_qs()
        return page

    def qs_installed(self, target):
        return setup("qs", target, "status")[0] == 0

    def refresh_qs(self):
        for target, _title, _note in QS_TARGETS:
            installed = self.qs_installed(target)
            self.qs_states[target].set_text("установлено" if installed else "не установлено")
            self.qs_buttons[target].set_label("Отключить" if installed else "Подключить")

    def toggle_qs(self, _button, target):
        action = "remove" if self.qs_installed(target) else "install"
        rc, out = setup("qs", target, action)
        self.say(out if rc == 0 else f"Ошибка: {out}")
        self.refresh_qs()

    def checks_page(self):
        page = box(10)
        self.report = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                   left_margin=8, right_margin=8, top_margin=8, bottom_margin=8)
        refresh = Gtk.Button(label="Проверить", halign=Gtk.Align.START)
        refresh.connect("clicked", self.run_checks)
        frame = Gtk.Frame()
        frame.set_child(scrolled(self.report))
        page.append(hint("Проверка запускает whisper-dictate-setup status: зависимости, модели, ключи, аудио."))
        page.append(refresh)
        page.append(frame)
        return page

    def run_checks(self, _button):
        rc, out = setup("status")
        self.report.get_buffer().set_text(out or "Проверка не вернула результата.")
        self.say("Проверка завершена." if rc == 0 else "Проверка нашла проблемы: см. текст выше.")


class Application(Gtk.Application):
    def __init__(self):
        # NATA_APP_ID — запуск второй копии (для проверки), не задевает основную.
        super().__init__(application_id=os.environ.get("NATA_APP_ID") or "io.github.phone1x.Nata",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window() or Settings(self)
        window.present()


if __name__ == "__main__":
    sys.exit(Application().run(sys.argv))
