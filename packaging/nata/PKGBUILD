# Maintainer: wowprofi4 <wowprofi4@gmail.com>
# Локальная сборка из дерева репозитория: cd packaging/nata && makepkg -si
# Для AUR заменить _src на tarball релиза (source=(...) + sha256sums).
pkgname=nata
pkgver=0.1.0
pkgrel=3
pkgdesc='Nata: voice dictation for Wayland (whisper.cpp, optional cloud STT and translation, GTK setup, Quickshell widget)'
arch=(any)
url='https://github.com/PHONE1X/nata'
license=(MIT)
depends=(fish jq python python-gobject gtk4 libsecret util-linux curl ffmpeg pipewire wl-clipboard libnotify ydotool whisper-cpp ggml-vulkan)
makedepends=()
optdepends=('uv: installing the OPUS-MT translation engine from the GUI'
            'fzf: terminal setup menu (whisper-dictate-setup --tui)'
            'quickshell: standalone widget and Quickshell integration')
backup=(etc/whisper-dictate/dictate.conf)
install=nata.install
_src="$startdir/../.."

package() {
  cd "$_src"
  install -Dm755 bin/whisper-dictate       "$pkgdir/usr/bin/whisper-dictate"
  install -Dm755 bin/whisper-dictate-setup "$pkgdir/usr/bin/whisper-dictate-setup"
  install -Dm755 bin/whisper-dictate-gui   "$pkgdir/usr/bin/whisper-dictate-gui"

  local f
  for f in lib/*.fish lib/*.py lib/VERSION; do
    install -Dm644 "$f" "$pkgdir/usr/lib/whisper-dictate/${f##*/}"
  done
  chmod 755 "$pkgdir"/usr/lib/whisper-dictate/*.py
  cp -r share/quickshell "$pkgdir/usr/lib/whisper-dictate/quickshell"

  install -Dm644 etc/whisper-dictate/dictate.conf "$pkgdir/etc/whisper-dictate/dictate.conf"
  install -Dm644 share/whisper-dictate/secrets.env.example \
    "$pkgdir/usr/share/whisper-dictate/secrets.env.example"
  for f in share/applications/*.desktop; do
    install -Dm644 "$f" "$pkgdir/usr/share/applications/${f##*/}"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
