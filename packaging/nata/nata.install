post_install() {
  echo ':: Nata установлена.'
  echo ':: Настройка: whisper-dictate-gui (ключи, модели, горячая клавиша, Quickshell).'
  echo ':: В терминале то же меню: whisper-dictate-setup --tui (нужен fzf).'
  echo ':: Переключатель записи: команда whisper-dictate (без аргументов).'
  echo ':: Для вставки нужен запущенный ydotoold.'
}

post_upgrade() {
  post_install
}
