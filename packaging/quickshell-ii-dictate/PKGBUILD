# Maintainer: wowprofi4 <wowprofi4@gmail.com>
# Патч для конфигурации Quickshell ii (dots-hyprland): индикатор в баре запускает /usr/bin/whisper-dictate.
# Пакет сам ~/.config не трогает; применить вручную: quickshell-ii-dictate-apply
pkgname=quickshell-ii-dictate
pkgver=0.1.0
pkgrel=1
pkgdesc='Quickshell ii patch: point dictation bar indicator to whisper-dictate'
arch=(any)
url='https://github.com/wowprofi4/whisper-dictate'
license=(MIT)
depends=(whisper-dictate patch)
source=(0001-dictate-script-path.patch quickshell-ii-dictate-apply)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 0001-dictate-script-path.patch \
    "$pkgdir/usr/share/$pkgname/0001-dictate-script-path.patch"
  install -Dm755 quickshell-ii-dictate-apply "$pkgdir/usr/bin/quickshell-ii-dictate-apply"
}
