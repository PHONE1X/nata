#!/bin/sh
# Подключает индикатор диктовки Quickshell ii к /usr/bin/whisper-dictate.
#   quickshell-ii-dictate-apply [--ii-dir DIR] [--revert]
# По умолчанию DIR = ~/.config/quickshell/ii. Идемпотентно; перед правкой делает копию .bak_whisper-dictate.
set -eu
dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/ii"
revert=0
status=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ii-dir) dir="$2"; shift ;;
    --revert) revert=1 ;;
    --status) status=1 ;;
    -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
    *) echo "неизвестный аргумент: $1" >&2; exit 2 ;;
  esac
  shift
done
patch_file="${QII_DICTATE_PATCH:-/usr/share/quickshell-ii-dictate/0001-dictate-script-path.patch}"
target="$dir/modules/common/Directories.qml"
[ -f "$target" ] || { echo "не найден $target" >&2; exit 1; }
if [ "$status" = 1 ]; then
  if patch -R -p1 -d "$dir" --dry-run -s -i "$patch_file" >/dev/null 2>&1; then
    echo "подключён"; exit 0
  fi
  echo "не подключён"; exit 1
fi
if [ "$revert" = 1 ]; then
  patch -R -p1 -d "$dir" -i "$patch_file"
  exit 0
fi
if patch -R -p1 -d "$dir" --dry-run -s -i "$patch_file" >/dev/null 2>&1; then
  echo "уже применено"
  exit 0
fi
cp -p "$target" "$target.bak_whisper-dictate"
patch -p1 -d "$dir" -i "$patch_file"
echo "готово; перезапусти quickshell (бэкап: $target.bak_whisper-dictate)"
