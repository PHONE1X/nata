#!/usr/bin/env python3
"""Файловая имитация secret-tool для тестов: store/lookup/search --all/clear.
Хранилище: $STUB_SECRET_DIR (по умолчанию ./.stub-secrets). Формат вывода
search совпадает с настоящим secret-tool."""
import os
import shutil
import sys

root = os.environ.get("STUB_SECRET_DIR", ".stub-secrets")
os.makedirs(root, exist_ok=True)


def items():
    out = []
    for n in sorted((n for n in os.listdir(root) if n.isdigit()), key=int):
        d = os.path.join(root, n)
        attrs = dict(l.rstrip("\n").split("=", 1) for l in open(d + "/attrs") if "=" in l)
        out.append({
            "id": n, "dir": d, "attrs": attrs,
            "label": open(d + "/label").read(),
            "secret": open(d + "/secret").read(),
            "modified": open(d + "/modified").read(),
        })
    return out


def pairs(args):
    return dict(zip(args[0::2], args[1::2]))


def matching(want):
    return [i for i in items() if all(i["attrs"].get(k) == v for k, v in want.items())]


def main():
    a = sys.argv[1:]
    if not a:
        return 2
    cmd, rest = a[0], a[1:]
    if cmd == "store":
        label = ""
        if rest and rest[0].startswith("--label="):
            label, rest = rest[0][8:], rest[1:]
        want = pairs(rest)
        secret = sys.stdin.read()
        exact = [i for i in items() if i["attrs"] == want]
        if exact:
            d = exact[0]["dir"]
        else:
            nid = max([int(i["id"]) for i in items()] + [0]) + 1
            d = os.path.join(root, str(nid))
            os.makedirs(d)
        open(d + "/attrs", "w").write("".join(f"{k}={v}\n" for k, v in want.items()))
        open(d + "/label", "w").write(label)
        open(d + "/secret", "w").write(secret)
        clock = os.path.join(root, ".clock")
        tick = int(open(clock).read()) + 1 if os.path.exists(clock) else 1
        open(clock, "w").write(str(tick))
        open(d + "/modified", "w").write(f"2026-10-16 12:00:{tick:05d}")
        return 0
    if cmd == "lookup":
        m = matching(pairs(rest))
        if not m:
            return 1
        sys.stdout.write(m[0]["secret"])
        return 0
    if cmd == "search":
        rest = [r for r in rest if r != "--all"]
        m = matching(pairs(rest))
        if not m:
            return 1
        for i in m:
            print(f"[/{i['id']}]")
            print(f"label = {i['label']}")
            print(f"secret = {i['secret']}")
            print(f"created = {i['modified']}")
            print(f"modified = {i['modified']}")
            print("schema = org.freedesktop.Secret.Generic")
            for k, v in i["attrs"].items():
                print(f"attribute.{k} = {v}")
        return 0
    if cmd == "clear":
        for i in matching(pairs(rest)):
            shutil.rmtree(i["dir"])
        return 0
    return 2


sys.exit(main())
